{
  "name": "coding-bootcamp",
  "private": true,
  "type": "module",
  "description": "Interview practice: Python and TypeScript exercises with automatic tests.",
  "scripts": {
    "ts": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"typescript/exercises/**/*.test.ts\"",
    "ts:0": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"typescript/exercises/week0_js_basics/*.test.ts\"",
    "ts:1": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"typescript/exercises/week1_algorithms/*.test.ts\"",
    "ts:2": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"typescript/exercises/week2_async_and_types/*.test.ts\"",
    "typecheck": "tsc -p typescript/tsconfig.json",
    "verify:ts": "node scripts/verify_typescript.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
