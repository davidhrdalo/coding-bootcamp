  {
    "block": "block4_changing_data_and_design",
    "id": "30_create_table",
    "title": "CREATE TABLE with constraints",
    "mode": "script",
    "ordered": true,
    "verify": [
      "SELECT name, lower(type) AS type, \"notnull\" AS not_null, pk, dflt_value IS NOT NULL AS has_default FROM pragma_table_info('reviews') ORDER BY cid",
      "SELECT \"table\" AS ref_table, \"from\" AS from_col, \"to\" AS to_col FROM pragma_foreign_key_list('reviews') ORDER BY \"from\""
    ],
    "probes": [
      {
        "sql": "INSERT INTO reviews (product_id, customer_id, rating) VALUES (1, 1, 5)",
        "expect": "ok",
        "why": "a valid review without a comment or date must work"
      },
      {
        "sql": "INSERT INTO reviews (product_id, customer_id, rating) VALUES (1, 1, 6)",
        "expect": "error",
        "why": "a rating above 5 must be rejected"
      },
      {
        "sql": "INSERT INTO reviews (product_id, customer_id, rating) VALUES (1, 1, 0)",
        "expect": "error",
        "why": "a rating below 1 must be rejected"
      },
      {
        "sql": "INSERT INTO reviews (customer_id, rating) VALUES (1, 3)",
        "expect": "error",
        "why": "product_id is required"
      },
      {
        "sql": "INSERT INTO reviews (product_id, customer_id, rating) VALUES (9999, 1, 3)",
        "expect": "error",
        "why": "the product must exist (foreign key)"
      },
      {
        "sql": "INSERT INTO reviews (product_id, customer_id, rating) VALUES (1, 9999, 3)",
        "expect": "error",
        "why": "the customer must exist (foreign key)"
      }
    ]
  },
  {
    "block": "block4_changing_data_and_design",
    "id": "31_indexes",
    "title": "Indexes and query plans",
    "mode": "script",
    "ordered": true,
    "probes": [
      {
        "plan": "SELECT * FROM orders WHERE customer_id = 3",
        "must_contain": [
          "INDEX"
        ],
        "why": "Create an index on orders(customer_id)."
      },
      {
        "plan": "SELECT name FROM products WHERE category = 'Books' ORDER BY price",
        "must_contain": [
          "INDEX"
        ],
        "must_not_contain": [
          "TEMP B-TREE"
        ],
        "why": "Create ONE index on products(category, price): equality column first, sort column second."
      }
    ]
  }
]
