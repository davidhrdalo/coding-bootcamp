{
  "name": "coding-bootcamp-web",
  "private": true,
  "type": "module",
  "description": "DOM, fetch and React exercises with automatic tests (Vitest + jsdom + Testing Library).",
  "scripts": {
    "test": "vitest run",
    "test:dom": "vitest run exercises/dom",
    "test:api": "vitest run exercises/api",
    "test:react": "vitest run exercises/react",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
